# Copy this file to ".env" and fill in your values. ".env" is gitignored, so
# secrets never get committed. The app loads it automatically at startup
# (app/envfile.py) and never overrides variables already set in your shell.

# --- AI (chat + AI source-document generation) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# CHAT_MODEL=claude-haiku-4-5

# --- Optional local semantic search (needs requirements-embeddings.txt) ---
# PLATFORM_EMBEDDINGS=1
# PLATFORM_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Optional PostgreSQL backend (needs requirements-postgres.txt) ---
# PLATFORM_DB_URL=postgresql://user:password@localhost:5432/clinical

# --- Security (all default-safe; see README "Data security") ---
# CHAT_DEIDENTIFY=1
# PLATFORM_AUTH_TOKEN=choose-a-strong-token
# PLATFORM_ENCRYPTION_KEY=choose-a-passphrase
